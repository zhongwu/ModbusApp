{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ModbusApp",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ModbusApp/bin/Debug/net10.0-windows/ModbusApp.dll",
      "cwd": "${workspaceFolder}/src/ModbusApp",
      "stopAtEntry": false
    },
    {
      "name": "Debug ModbusApp.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ModbusApp.Web/bin/Debug/net10.0/ModbusApp.Web.dll",
      "cwd": "${workspaceFolder}/src/ModbusApp.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5202"
      }
    },
    {
      "name": "Debug ModbusSim",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/ModbusSim/bin/Debug/net10.0/ModbusSim.dll",
      "cwd": "${workspaceFolder}/tools/ModbusSim",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Debug Sim + App",
      "configurations": [
        "Debug ModbusSim",
        "Debug ModbusApp"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Sim + Web",
      "configurations": [
        "Debug ModbusSim",
        "Debug ModbusApp.Web"
      ],
      "stopAll": true
    }
  ]
}
