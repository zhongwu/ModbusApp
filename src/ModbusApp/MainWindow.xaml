<Window x:Class="ModbusApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Modbus X-bar Monitor" Height="650" Width="1000">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="2,0,10,0"/><Setter Property="MinWidth" Value="50"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="12,2"/></Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Host" VerticalAlignment="Center"/><TextBox Text="{Binding Host}" Width="100"/>
            <TextBlock Text="Port" VerticalAlignment="Center"/><TextBox Text="{Binding Port}"/>
            <TextBlock Text="Unit" VerticalAlignment="Center"/><TextBox Text="{Binding UnitId}"/>
            <TextBlock Text="Start" VerticalAlignment="Center"/><TextBox Text="{Binding StartAddress}"/>
            <TextBlock Text="Count" VerticalAlignment="Center"/><TextBox Text="{Binding Count}"/>
            <TextBlock Text="Interval ms" VerticalAlignment="Center"/><TextBox Text="{Binding IntervalMs}"/>
            <TextBlock Text="Scale ÷" VerticalAlignment="Center"/><TextBox Text="{Binding Scale}"/>
            <TextBlock Text="Chart reg #" VerticalAlignment="Center"/><TextBox Text="{Binding ChartRegister}"/>
            <TextBlock Text="Subgroup n" VerticalAlignment="Center"/><TextBox Text="{Binding SubgroupSize}"/>
            <Button Content="Connect" Command="{Binding ConnectCommand}"/>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
            <Button Content="Reset chart" Command="{Binding ResetChartCommand}"/>
        </WrapPanel>
        <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Style.Triggers><DataTrigger Binding="{Binding InAlarm}" Value="True"><Setter Property="Background" Value="#FFCDD2"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
                <TextBlock Text="   ALARM — run rule violated" Foreground="#B71C1C" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding InAlarm}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
            <DataGrid Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Registers}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Reg" Binding="{Binding Address}" Width="60"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <scott:WpfPlot x:Name="Plot" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding AlarmLog}"/>
        </Grid>
    </DockPanel>
</Window>
